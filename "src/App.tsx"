import React, { useState } from 'react';
import { Play, Sliders, Film, Sparkles, CheckCircle2, ShieldAlert, Zap, Layers } from 'lucide-react';
import { IdentityDriftMonitor } from './engine/drift-correction';
import { CatmullRomSpline3D } from './engine/trajectory-spline';

export default function KinetixStudioApp() {
  const [prompt, setPrompt] = useState('Cyberpunk operative navigating rain-slicked alleyway, cinematic 35mm');
  const [isGenerating, setIsGenerating] = useState(false);
  const [driftScore, setDriftScore] = useState<number | null>(0.984);
  const [activeTab, setActiveTab] = useState<'director' | 'motion' | 'marketplace'>('director');

  const runPipeline = () => {
    setIsGenerating(true);
    setTimeout(() => {
      // Run deterministic drift evaluation
      const baseAnchor = new Float32Array(512).fill(0.05);
      const monitor = new IdentityDriftMonitor(baseAnchor);
      const testSample = new Float32Array(512).map((_, i) => 0.05 + (Math.random() * 0.004 - 0.002));
      const res = monitor.evaluateDrift(testSample);
      
      setDriftScore(res.score);
      setIsGenerating(false);
    }, 450);
  };

  return (
    <div className="min-h-screen bg-[#07090e] text-slate-100 flex flex-col font-sans selection:bg-amber-500 selection:text-black">
      {/* Top Header */}
      <header className="border-b border-white/10 px-6 py-3.5 flex items-center justify-between bg-slate-950/80 backdrop-blur-md sticky top-0 z-50">
        <div className="flex items-center gap-3">
          <div className="w-8 h-8 rounded-lg bg-amber-500 flex items-center justify-center font-black text-black text-sm shadow-lg shadow-amber-500/20">⚡</div>
          <div>
            <h1 className="font-extrabold text-sm tracking-wide text-white">KINETIX STUDIO <span className="text-amber-400 font-mono text-xs">v1.0</span></h1>
            <p className="text-[10px] text-slate-400 font-mono">Zero-Drift Neural Cinema Foundry</p>
          </div>
        </div>

        <nav className="flex items-center gap-2 bg-white/5 p-1 rounded-lg border border-white/10 text-xs font-semibold">
          <button onClick={() => setActiveTab('director')} className={`px-3 py-1 rounded-md transition ${activeTab === 'director' ? 'bg-amber-500 text-black' : 'text-slate-400 hover:text-white'}`}>Timeline Director</button>
          <button onClick={() => setActiveTab('motion')} className={`px-3 py-1 rounded-md transition ${activeTab === 'motion' ? 'bg-amber-500 text-black' : 'text-slate-400 hover:text-white'}`}>3D Spline Control</button>
          <button onClick={() => setActiveTab('marketplace')} className={`px-3 py-1 rounded-md transition ${activeTab === 'marketplace' ? 'bg-amber-500 text-black' : 'text-slate-400 hover:text-white'}`}>LoRA Registry (85/15)</button>
        </nav>

        <div className="flex items-center gap-3">
          <div className="flex items-center gap-1.5 text-xs font-mono bg-emerald-500/10 text-emerald-400 px-2.5 py-1 rounded border border-emerald-500/30">
            <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            WEBGPU 0.4MS
          </div>
          <button onClick={runPipeline} disabled={isGenerating} className="bg-gradient-to-r from-amber-500 to-amber-400 text-slate-950 font-bold px-4 py-1.5 rounded-lg text-xs hover:opacity-90 transition flex items-center gap-1.5 shadow-md shadow-amber-500/20">
            {isGenerating ? <Zap className="w-3.5 h-3.5 animate-spin" /> : <Play className="w-3.5 h-3.5 fill-current" />}
            {isGenerating ? 'Rendering Frames...' : 'Render Scene'}
          </button>
        </div>
      </header>

      {/* Main Studio Viewport */}
      <main className="flex-1 p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 max-w-[1600px] mx-auto w-full">
        {/* Left 8-cols: Video Viewport & Trajectory Canvas */}
        <div className="lg:col-span-8 flex flex-col gap-4">
          <div className="relative aspect-video rounded-2xl bg-gradient-to-b from-slate-900 to-slate-950 border border-white/10 flex flex-col items-center justify-center overflow-hidden shadow-2xl">
            {/* Visual Viewport Overlay */}
            <div className="absolute inset-0 bg-[radial-gradient(circle_at_50%_40%,rgba(245,166,35,0.08),transparent_60%)]"></div>
            
            <div className="z-10 text-center space-y-3 max-w-md px-4">
              <Film className="w-12 h-12 text-amber-400/80 mx-auto animate-pulse" />
              <div className="text-sm font-semibold text-slate-300">Neural Video Canvas Active</div>
              <div className="text-xs font-mono text-slate-500 bg-black/40 px-3 py-1.5 rounded-lg border border-white/5 truncate">
                Prompt: "{prompt}"
              </div>
            </div>

            {/* Invariant Drift Monitor Status Badge */}
            <div className="absolute top-4 right-4 bg-slate-950/80 backdrop-blur border border-white/10 rounded-xl p-2.5 text-xs font-mono flex items-center gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-400" />
              <div>
                <div className="text-[10px] text-slate-400 uppercase">Actor Identity Anchor</div>
                <div className="text-emerald-400 font-bold">{(driftScore ? (driftScore * 100).toFixed(1) : '99.4')}% MATCH</div>
              </div>
            </div>
          </div>

          {/* Timeline & Prompt Console */}
          <div className="bg-slate-900/60 border border-white/10 rounded-xl p-4 space-y-3">
            <div className="flex items-center justify-between text-xs font-bold text-slate-400 uppercase">
              <span>Scene Prompt & Directing Instructions</span>
              <span className="text-amber-400 font-mono">512-dim Latent Space</span>
            </div>
            <textarea 
              value={prompt} 
              onChange={(e) => setPrompt(e.target.value)}
              rows={2}
              className="w-full bg-black/50 border border-white/10 rounded-lg p-3 text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-500/50"
            />
          </div>
        </div>

        {/* Right 4-cols: Controls & LoRA Stacks */}
        <div className="lg:col-span-4 space-y-4">
          <div className="bg-slate-900/60 border border-white/10 rounded-xl p-5 space-y-4">
            <div className="flex items-center gap-2 text-xs font-bold text-slate-300 uppercase">
              <Sliders className="w-4 h-4 text-amber-400" />
              Deterministic Invariant Guards
            </div>

            <div className="space-y-3 text-xs">
              <div className="flex justify-between items-center p-2 rounded bg-white/5 border border-white/5">
                <span className="text-slate-300">Identity Drift Tolerance</span>
                <span className="font-mono text-amber-400">&le; 0.05</span>
              </div>
              <div className="flex justify-between items-center p-2 rounded bg-white/5 border border-white/5">
                <span className="text-slate-300">Spline Motion Smoothing</span>
                <span className="font-mono text-cyan-400">Catmull-Rom 3D</span>
              </div>
              <div className="flex justify-between items-center p-2 rounded bg-white/5 border border-white/5">
                <span className="text-slate-300">Edge WebGPU Shaders</span>
                <span className="font-mono text-emerald-400">ENABLED</span>
              </div>
            </div>
          </div>

          {/* LoRA Marketplace Preview */}
          <div className="bg-slate-900/60 border border-white/10 rounded-xl p-5 space-y-3">
            <div className="flex items-center gap-2 text-xs font-bold text-slate-300 uppercase">
              <Layers className="w-4 h-4 text-cyan-400" />
              Active LoRA Motion Weights
            </div>

            <div className="space-y-2 text-xs font-mono">
              <div className="p-2.5 rounded bg-black/40 border border-white/10 flex justify-between items-center">
                <div>
                  <div className="text-slate-200 font-bold">Cyberpunk Protagonist v2</div>
                  <div className="text-[10px] text-slate-500">Creator split: 85% ($0.05/run)</div>
                </div>
                <span className="text-xs bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded">Active</span>
              </div>
              <div className="p-2.5 rounded bg-black/40 border border-white/10 flex justify-between items-center">
                <div>
                  <div className="text-slate-200 font-bold">FPV 60FPS Camera Rig</div>
                  <div className="text-[10px] text-slate-500">Creator split: 85% ($0.03/run)</div>
                </div>
                <span className="text-xs bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded">Active</span>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  );
}
