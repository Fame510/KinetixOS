-- ============================================================================
-- KinetixOS Sovereign Database Schema: Relational Engine & Creator Marketplace
-- ============================================================================

CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- 1. Accounts & User Profiles
CREATE TABLE IF NOT EXISTS accounts (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    email TEXT UNIQUE NOT NULL,
    wallet_address TEXT,
    api_key_hash TEXT UNIQUE NOT NULL,
    tier TEXT DEFAULT 'creator' CHECK (tier IN ('creator', 'studio', 'enterprise')),
    stripe_customer_id TEXT,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 2. LoRA Model & Motion Registry
CREATE TABLE IF NOT EXISTS lora_registry (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    creator_id UUID NOT NULL REFERENCES accounts(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    slug TEXT UNIQUE NOT NULL,
    category TEXT NOT NULL CHECK (category IN ('character', 'style', 'camera_motion', 'lighting', 'vfx')),
    model_sha256 TEXT UNIQUE NOT NULL,
    weights_uri TEXT NOT NULL,
    trigger_tokens TEXT[] NOT NULL DEFAULT '{}',
    base_model TEXT NOT NULL DEFAULT 'kinetix-v1-latent',
    price_per_invocation_cents INTEGER NOT NULL DEFAULT 5,
    revenue_share_pct NUMERIC(4, 2) NOT NULL DEFAULT 85.00,
    total_invocations BIGINT DEFAULT 0,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 3. Generation Jobs & Provenance Ledger
CREATE TABLE IF NOT EXISTS generation_jobs (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    account_id UUID NOT NULL REFERENCES accounts(id),
    prompt TEXT NOT NULL,
    negative_prompt TEXT,
    identity_anchor_vector BYTEA,
    spline_trajectory_json JSONB,
    active_loras JSONB NOT NULL DEFAULT '[]'::jsonb,
    output_video_url TEXT,
    provenance_merkle_hash TEXT,
    drift_score NUMERIC(5, 4),
    status TEXT NOT NULL DEFAULT 'queued' CHECK (status IN ('queued', 'synthesizing', 'interpolating', 'completed', 'failed')),
    render_latency_ms INTEGER,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 4. Payout Escrow & Ledger
CREATE TABLE IF NOT EXISTS creator_settlements (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    creator_id UUID NOT NULL REFERENCES accounts(id),
    lora_id UUID NOT NULL REFERENCES lora_registry(id),
    job_id UUID NOT NULL REFERENCES generation_jobs(id),
    gross_amount_cents INTEGER NOT NULL,
    creator_payout_cents INTEGER NOT NULL,
    platform_take_cents INTEGER NOT NULL,
    settlement_status TEXT DEFAULT 'settled' CHECK (settlement_status IN ('pending', 'settled', 'refunded')),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Indexes for sub-millisecond query performance
CREATE INDEX IF NOT EXISTS idx_lora_category ON lora_registry(category);
CREATE INDEX IF NOT EXISTS idx_jobs_account ON generation_jobs(account_id);
CREATE INDEX IF NOT EXISTS idx_jobs_status ON generation_jobs(status);
CREATE INDEX IF NOT EXISTS idx_settlements_creator ON creator_settlements(creator_id);
